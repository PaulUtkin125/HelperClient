<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HelperClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HelperClient.Views.MainWindow"
        Icon="/Assets/logo.ico"
        Title="HelperClient"
        Width="800" Height="700"
        TransparencyLevelHint="None"
        Background="#F5F5F5"
        CanResize="True">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto, *">
		<!-- Верхняя панель: статус операции и кнопка авторизации -->
		<Border Grid.Row="0" Background="White" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
				<TextBlock Text="{Binding Home.StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="Green"
                           FontSize="14"
                           IsVisible="{Binding Home.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				<Button Content="Авторизация"
                        Classes="accent"
                        Command="{Binding OpenAuthCommand}"/>
			</StackPanel>
		</Border>

		<!-- Основное содержимое -->
		<TabView Grid.Row="1" Name="TabContainer" Background="Transparent" SelectedIndex="0">
			<TabItem Header="Главная">
				<ContentControl Content="{Binding Home}" Tag="Home"/>
			</TabItem>
			<TabItem Header="Обновления">
				<ContentControl Content="{Binding Update}" Tag="Update"/>
			</TabItem>
		</TabView>
	</Grid>
</Window>
