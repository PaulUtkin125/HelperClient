<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
		Height="500" Width="325" 
		MaxWidth="325"
		MinHeight="500" MinWidth="325"
        x:Class="HelperClient.MainWindow"
        Title="HelperClient"
		x:DataType="vm:MainWindowViewModel"
		xmlns:vm="using:HelperClient.ViewModels"
		xmlns:views="using:HelperClient">

	<Window.DataTemplates>
		<DataTemplate DataType="vm:HomeViewModel">
			<views:HomePage/>
		</DataTemplate>
		<DataTemplate DataType="vm:MenuViewModel">
			<views:MenuUC/>
		</DataTemplate>
		<DataTemplate DataType="vm:ProfileViewModel">
			<views:ProfilePage/>
		</DataTemplate>
		<DataTemplate DataType="vm:PartyLicensyViewModel">
			<views:PartyLicensyPage/>
		</DataTemplate>
	</Window.DataTemplates>	
	
	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="60"/>
		</Grid.RowDefinitions>

		<!-- Шапка/меню -->
		<Button Command="{Binding GoToMenuCommand}" ZIndex="10" Margin="10 2 20 2" Width="20" Padding="0" Background="Transparent" >
			<Image Source="/Assets/Image/gkb_logo_white_l.png" />
		</Button>
		<StackPanel Grid.Row="0" VerticalAlignment="Center">
			<TextBlock Text="{Binding PageHeadTitle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
		</StackPanel>

		<!-- Меню -->
		
		<ContentControl Grid.Row="1" Grid.RowSpan="2" x:Name="MainFrame" Content="{Binding CurrentPage}"/>
		
		<!-- Основное тело -->
		
		


	</Grid>
	
</Window>
