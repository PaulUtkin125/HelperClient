<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="325" d:DesignHeight="500"
             x:Class="HelperClient.HomePage"
                         xmlns:vm="using:HelperClient.ViewModels"
                         x:DataType="vm:HomeViewModel">

        <Grid>

                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Верхняя часть: произвольная проблема -->
                <StackPanel Grid.Row="0" Margin="10 10 10 0" Background="#f0f0f0">
                        <CheckBox Content="Моей проблемы нет в списке" IsChecked="{Binding IsCustomErrorBoxEnable}"/>
                        <TextBox TextWrapping="Wrap" Width="300" Margin="0 5 0 5"
                                         IsEnabled="{Binding IsCustomErrorBoxEnable}"
                                         Text="{Binding CustomProblem}"
                                         Watermark="Опишите вашу проблему" MaxLength="255"/>
                </StackPanel>

                <!-- Список категорий проблем из /Category/GetAll с сохранением вложенной структуры -->
                <Border Grid.Row="1" Background="#f0f0f0" Margin="0 10 0 0">
                        <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Categories}" Margin="10 5">
                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CategoryItemViewModel">
                                                        <RadioButton GroupName="ProblemCategory"
                                                                     IsChecked="{Binding IsSelected}"
                                                                     Margin="{Binding Indent, Converter={x:Static vm:IndentToThicknessConverter.Instance}}"
                                                                     Padding="0">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                        <TextBlock Text="(уточните в комментарии)"
                                                                                   FontSize="10" Foreground="#888888"
                                                                                   IsVisible="{Binding !IsLeaf}"/>
                                                                </StackPanel>
                                                        </RadioButton>
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                </Border>

                <!-- Статус операций и синхронизации -->
                <Border Grid.Row="2" Background="#e8e8e8" Padding="10 4">
                        <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                                   FontSize="11" Foreground="#555555"
                                                   VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="⟳" Command="{Binding SyncNowCommand}"
                                                ToolTip.Tip="Актуализировать данные машины на сервере"
                                                Padding="6 2" Background="Transparent"/>
                        </Grid>
                </Border>

                <!-- Нижняя панель: контактный мобильный телефон + отправка заявки -->
                <Grid Grid.Row="3" Background="#f0f0f0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Width="160" VerticalAlignment="Center"
                                         Text="{Binding PhoneNumber}"
                                         Watermark="+7 (000) 000-00-00" Margin="10 0 10 0"/>
                        <Button Grid.Column="1" Content="Отправить"
                                        Command="{Binding SubmitRequestCommand}"
                                        IsEnabled="{Binding CanSubmit}"
                                        Height="40" Margin="0 0 10 0" Padding="12 0"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="#63b076"
                                        Foreground="White"/>
                </Grid>
        </Grid>

</UserControl>
